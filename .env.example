# =====================================================================
# SOAR IOC Factory — variables d'environnement (modèle, SANS secret)
# Copier vers .env puis renseigner les valeurs. .env est ignoré par Git.
# Générer chaque secret avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# --- Application ---
# development | testing | production
# En production, l'API refuse de démarrer si SECRET_KEY est faible,
# si AUTH_ENABLED=false, si DEBUG=true ou si CORS_ORIGINS contient '*'.
APP_ENV=development
DEBUG=false

# --- Sécurité (OBLIGATOIRE : valeur aléatoire >= 32 caractères) ---
SECRET_KEY=CHANGE-ME-48-chars-random
# Durée de validité des jetons d'accès (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Authentification activée par défaut (false = dev local uniquement)
AUTH_ENABLED=true
# Clé partagée utilisée par n8n (en-tête X-API-Key). Vide = accès service désactivé.
SERVICE_API_KEY=CHANGE-ME-service-key

# --- Premier administrateur (créé au démarrage si la table users est vide) ---
# Politique : >= 12 caractères, au moins 3 types (minuscule, majuscule, chiffre, symbole).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@soar.local
ADMIN_PASSWORD=

# --- Protection contre les abus ---
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# true uniquement derrière le nginx du projet (déploiement AWS)
TRUST_PROXY_HEADERS=false

# --- PostgreSQL ---
POSTGRES_USER=soar
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=soar_ioc

# --- n8n (profil) ---
N8N_ENCRYPTION_KEY=CHANGE-ME-32-chars-random-key
N8N_DB=soar_n8n

# --- Clés API de Threat Intelligence (FACULTATIVES) ---
# Sans clé, la source concernée est affichée « Configuration manquante ».
OTX_API_KEY=
ABUSEIPDB_API_KEY=
# abuse.ch (URLhaus, ThreatFox, MalwareBazaar) : https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# --- MISP ---
# Vide = publication MISP « non configurée » (jamais simulée).
MISP_URL=
MISP_KEY=
# true par défaut ; false uniquement pour un MISP de labo à certificat auto-signé
MISP_VERIFY_CERT=true

# --- Seuils de scoring (valeurs initiales, testables) ---
SCORE_THRESHOLD_PUBLISH=80
SCORE_THRESHOLD_MONITOR=50

# --- CORS (origines autorisées, séparées par des virgules ; jamais '*') ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
