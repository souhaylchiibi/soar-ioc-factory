# =====================================================================
# SOAR IOC Factory — variables d'environnement (modèle)
# Copier vers .env puis renseigner les valeurs. .env est ignoré par Git.
# =====================================================================

# --- Application ---
APP_ENV=development
DEBUG=false

# --- Sécurité (OBLIGATOIRE : valeur aléatoire longue) ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-48-chars-random

# --- PostgreSQL ---
POSTGRES_USER=soar
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=soar_ioc

# --- n8n (profil) ---
N8N_ENCRYPTION_KEY=CHANGE-ME-32-chars-random-key
N8N_DB=soar_n8n

# --- Clés API (FACULTATIVES — les collecteurs fonctionnent sans) ---
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# --- MISP (Phase 5) ---
MISP_URL=
MISP_KEY=
MISP_VERIFY_CERT=false

# --- Seuils de scoring (valeurs initiales, testables) ---
SCORE_THRESHOLD_PUBLISH=80
SCORE_THRESHOLD_MONITOR=50

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
